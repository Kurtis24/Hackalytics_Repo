# Supabase Configuration (optional — only needed if you persist results)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Optional: external sports-odds API key (RapidAPI). Leave blank to use
# the built-in public sports APIs + locally generated odds.
RAPIDAPI_KEY=

# Optional: path to the trained model checkpoint (relative to Backend/).
# Defaults to models/model.ckpt — uncomment only if you move the checkpoint.
# MODEL_CHECKPOINT_PATH=models/model.ckpt
